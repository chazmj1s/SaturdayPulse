<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SaturdayPulse.Models"
             xmlns:helpers="clr-namespace:SaturdayPulse.Helpers"
             xmlns:controls="clr-namespace:SaturdayPulse.Controls"
             xmlns:viewmodels="clr-namespace:SaturdayPulse.ViewModels"
             x:Class="SaturdayPulse.Views.SettingsPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,24">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 0: Page title + Close                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,10">
            <Label Grid.Column="0"
                   Text="Settings"
                   FontSize="20" FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="1"
                   Text="Close"
                   FontSize="14" FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 1: Accordion sections                           -->
        <!-- Order: User Profile, App Settings, Favorites,       -->
        <!-- Season Pass, Content, Support, Debug Log            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="False">
            <ScrollView>
                <VerticalStackLayout Spacing="0">

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: User Profile (default expanded)         -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="UserProfile" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="User Profile"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUserProfileExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUserProfileExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsUserProfileExpanded}"
                                         Padding="16,10" Spacing="10">

                        <!-- User Name -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="User Name" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditHandleCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Handle}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▾" FontSize="14" Margin="4,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <!-- Email + notification checkbox, same line -->
                        <Grid ColumnDefinitions="90,Auto,*,Auto,Auto" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="Email" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="2">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditEmailCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{Binding EmailDisplay}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Text="▾" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <BoxView Grid.Column="2" Color="Transparent" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding MarketingEmailConsent}"
                                      Scale="0.8" VerticalOptions="Center"
                                      Color="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                            <Label Grid.Column="4" Text="Allow notifications" FontSize="11" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />
                        </Grid>

                        <!-- Phone + notification status, same line (read-only - see EditPhoneCommand for the actual consent flow) -->
                        <Grid ColumnDefinitions="90,Auto,*,Auto,Auto" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="Phone" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="2">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditPhoneCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{Binding PhoneDisplay}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Text="▾" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <BoxView Grid.Column="2" Color="Transparent" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding MarketingSmsConsent}" IsEnabled="False"
                                      Scale="0.8" VerticalOptions="Center"
                                      Color="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                            <Label Grid.Column="4" Text="Allow notifications" FontSize="11" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />
                        </Grid>

                        <!-- Account: Login/Create Account, or Logout/Delete Account -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Account" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="20" IsVisible="{Binding IsLoggedOut}">
                                <Label Text="Login" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LoginCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="Create Account" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CreateAccountCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="20" IsVisible="{Binding IsLoggedIn}">
                                <Label Text="Logout" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="Change Account" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChangeAccountCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="Delete Account" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#C0392B, Dark=#E57373}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Stay logged in -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Stay logged in" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Switch Grid.Column="1" HorizontalOptions="Start"
                                    IsToggled="{Binding StayLoggedIn}"
                                    OnColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.1"
                             Color="{AppThemeBinding Light=Black, Dark=White}" />

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: App Settings (was User Config)          -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="UserConfig" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="App Settings"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUserConfigExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUserConfigExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsUserConfigExpanded}"
                                         Padding="16,10" Spacing="4">

                        <!-- Favorites first -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Favorites first" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Switch Grid.Column="1" HorizontalOptions="Start"
                                    IsToggled="{Binding ShowFavoritesFirst}"
                                    OnColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                        </Grid>

                        <!-- Default week -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Default week" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,*" ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDefaultWeekCommand}"
                                                          CommandParameter="Week1" />
                                </Grid.GestureRecognizers>

                                <Ellipse Grid.Column="0" WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                    <Ellipse.Triggers>
                                        <DataTrigger TargetType="Ellipse"
                                                     Binding="{Binding DefaultWeek}" Value="Week1">
                                            <Setter Property="Fill"
                                                    Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                            <Setter Property="StrokeThickness" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Ellipse"
                                                     Binding="{Binding DefaultWeek}" Value="Current">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Label Grid.Column="1" Text="Week 1" FontSize="13" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding DefaultWeek}" Value="Week1">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding DefaultWeek}" Value="Current">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <BoxView Grid.Column="2" Color="Transparent" />

                                <Ellipse Grid.Column="3" WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                    <Ellipse.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectDefaultWeekCommand}"
                                                              CommandParameter="Current" />
                                    </Ellipse.GestureRecognizers>
                                    <Ellipse.Triggers>
                                        <DataTrigger TargetType="Ellipse"
                                                     Binding="{Binding DefaultWeek}" Value="Current">
                                            <Setter Property="Fill"
                                                    Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                            <Setter Property="StrokeThickness" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Ellipse"
                                                     Binding="{Binding DefaultWeek}" Value="Week1">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Label Grid.Column="4" Text="Current" FontSize="13" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding DefaultWeek}" Value="Current">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding DefaultWeek}" Value="Week1">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <BoxView Grid.Column="5" Color="Transparent" />

                            </Grid>
                        </Grid>

                        <!-- Default conference -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Conference" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDefaultConferenceCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding DefaultConference}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▾" FontSize="14" Margin="4,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <!-- Default team -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="My Team" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDefaultTeamCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding DefaultTeamDisplay}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▾" FontSize="14" Margin="4,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <!-- Default landing page -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Landing page" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDefaultLandingPageCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding DefaultLandingPageDisplay}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▾" FontSize="14" Margin="4,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.1"
                             Color="{AppThemeBinding Light=Black, Dark=White}" />

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: Favorites (was Following)                -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="Following" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="Favorites"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsFollowingExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsFollowingExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsFollowingExpanded}" Spacing="0">

                        <Grid ColumnDefinitions="*,*"
                              BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}">

                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Teams" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="Teams" FontSize="13" FontAttributes="Bold"
                                       HorizontalOptions="Center" Padding="0,8">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTeamsView}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTeamsView}" Value="False">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2" HorizontalOptions="Fill">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsTeamsView}" Value="True">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsTeamsView}" Value="False">
                                            <Setter Property="Color" Value="Transparent" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Games" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="Games" FontSize="13" FontAttributes="Bold"
                                       HorizontalOptions="Center" Padding="0,8">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsGamesView}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsGamesView}" Value="False">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2" HorizontalOptions="Fill">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsGamesView}" Value="True">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsGamesView}" Value="False">
                                            <Setter Property="Color" Value="Transparent" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                            </VerticalStackLayout>

                        </Grid>

                        <!-- Teams list — flat (a specific conference is selected) -->
                        <CollectionView ItemsSource="{Binding Teams}"
                                        IsVisible="{Binding ShowFlatTeamsList}"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TeamInfo">
                                    <Grid ColumnDefinitions="*,Auto" Padding="16,5">
                                        <Label Grid.Column="0"
                                               Text="{Binding TeamName}"
                                               FontSize="13" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IsFollowed, Converter={StaticResource FollowTeamGlyphConverter}}"
                                               TextColor="{Binding IsFollowed, Converter={StaticResource FollowTeamColorConverter}}"
                                               FontSize="{StaticResource TeamIconSize}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                                                    CommandParameter="{Binding TeamID}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Teams list — grouped by conference (header filter set to "All") -->
                        <CollectionView ItemsSource="{Binding TeamGroups}"
                                        IsVisible="{Binding ShowGroupedTeamsList}"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ConferenceGroupInfo">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,20" Padding="16,5"
                                              BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#222222}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0" Text="{Binding ConferenceName}"
                                                   FontSize="12" FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1" FontSize="11" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▲" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                                        <Setter Property="Text" Value="▼" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>

                                        <CollectionView ItemsSource="{Binding Teams}"
                                                        IsVisible="{Binding IsExpanded}"
                                                        ItemSizingStrategy="MeasureAllItems">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="models:TeamInfo">
                                                    <Grid ColumnDefinitions="*,Auto" Padding="28,5">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding TeamName}"
                                                               FontSize="13" VerticalOptions="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding IsFollowed, Converter={StaticResource FollowTeamGlyphConverter}}"
                                                               TextColor="{Binding IsFollowed, Converter={StaticResource FollowTeamColorConverter}}"
                                                               FontSize="{StaticResource TeamIconSize}"
                                                               VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                                                                    CommandParameter="{Binding TeamID}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Games list — unchanged from before -->
                        <VerticalStackLayout IsVisible="{Binding IsGamesView}" Spacing="0">

                            <Picker ItemsSource="{Binding TierFilters}"
                                    SelectedItem="{Binding SelectedTier}"
                                    Margin="12,8" FontSize="13" />

                            <CollectionView ItemsSource="{Binding Games}"
                                            ItemSizingStrategy="MeasureAllItems">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RivalryInfo">
                                        <VerticalStackLayout Spacing="4" Padding="12,8">

                                            <!-- Title + ★ favorite + tier badge -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,0,0,4">

                                                <Label Grid.Column="0"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />

                                                <!-- Star: favorite this game -->
                                                <controls:FollowGameIcon
                                                        Grid.Column="1"
                                                        IsFollowed="{Binding IsGameFavorited}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End"
                                                        Margin="8,0">
                                                    <controls:FollowGameIcon.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePersonalCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </controls:FollowGameIcon.GestureRecognizers>
                                                </controls:FollowGameIcon>

                                                <Label Grid.Column="2"
                                                       Text="{Binding TierBadge}"
                                                       FontSize="16"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="End" />
                                            </Grid>

                                            <Grid ColumnDefinitions="24,*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="8">

                                                <!-- Heart: follow team 1 -->
                                                <controls:FollowTeamIcon
                                                        Grid.Row="0" Grid.Column="0"
                                                        IsFollowed="{Binding Team1IsFollowed}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center">
                                                    <controls:FollowTeamIcon.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                                                            CommandParameter="{Binding Team1Id}" />
                                                    </controls:FollowTeamIcon.GestureRecognizers>
                                                </controls:FollowTeamIcon>

                                                <Label Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Team1Name}"
                                                       FontSize="13"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Grid.Row="0" Grid.Column="2"
                                                       Text="{Binding DisplaySeries}"
                                                       FontSize="9"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                                       VerticalOptions="Center" />

                                                <Label Grid.Row="0" Grid.Column="3"
                                                       Text="{Binding DisplayAvgMargin}"
                                                       FontSize="9"
                                                       TextColor="{AppThemeBinding Light=#888888, Dark=#777777}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="End" />

                                                <!-- Heart: follow team 2 -->
                                                <controls:FollowTeamIcon
                                                        Grid.Row="1" Grid.Column="0"
                                                        IsFollowed="{Binding Team2IsFollowed}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center">
                                                    <controls:FollowTeamIcon.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                                                            CommandParameter="{Binding Team2Id}" />
                                                    </controls:FollowTeamIcon.GestureRecognizers>
                                                </controls:FollowTeamIcon>

                                                <Label Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding Team2Name}"
                                                       FontSize="13"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Grid.Row="1" Grid.Column="2"
                                                       Text="{Binding DisplayUpsetRate}"
                                                       FontSize="9"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                                       VerticalOptions="Center" />

                                                <Label Grid.Row="1" Grid.Column="3"
                                                       Text="{Binding DisplayAvgSwing}"
                                                       FontSize="9"
                                                       TextColor="{AppThemeBinding Light=#888888, Dark=#777777}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="End" />
                                            </Grid>

                                            <!-- Row divider -->
                                            <BoxView HeightRequest="1" Opacity="0.12"
                                                     Color="{AppThemeBinding Light=Black, Dark=White}" />

                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.1"
                             Color="{AppThemeBinding Light=Black, Dark=White}" />

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: Season Pass (new)                       -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="SeasonPass" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="Season Pass"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSeasonPassExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSeasonPassExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsSeasonPassExpanded}"
                                         Padding="16,10" Spacing="10">

                        <!-- Current and available entitlements -->
                        <CollectionView ItemsSource="{Binding SeasonPassEntries}"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:SeasonPassEntryViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding ProductKey}" FontSize="13" FontAttributes="Bold" />
                                            <Label Text="{Binding DisplayLine}" FontSize="11"
                                                   IsVisible="{Binding HasDisplayLine}"
                                                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding StatusKey}"
                                               FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding StatusKey}" Value="Purchase">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StatusKey}" Value="Active">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ResultWinLight}, Dark={StaticResource ResultWinDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StatusKey}" Value="Expired">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#999999, Dark=#777777}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SeasonPassCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No season passes yet." FontSize="12" Opacity="0.6" Padding="0,8" />
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <BoxView HeightRequest="1" Opacity="0.1"
                                 Color="{AppThemeBinding Light=Black, Dark=White}"
                                 IsVisible="{Binding IsAdmin}" />

                        <!-- Admin-only dev toggle -->
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8" IsVisible="{Binding IsAdmin}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetDevEntitlementCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Dev toggle" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Switch Grid.Column="1" HorizontalOptions="Start"
                                    IsToggled="{Binding HasSeasonPass, Mode=OneWay}"
                                    InputTransparent="True"
                                    OnColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.1"
                             Color="{AppThemeBinding Light=Black, Dark=White}" />

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: Content (new, read-only)                -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="Content" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="Content"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsContentExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsContentExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <CollectionView IsVisible="{Binding IsContentExpanded}"
                                    ItemsSource="{Binding ContentSections}"
                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ContentSectionViewModel">
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*,20" Padding="16,8"
                                          BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0" Text="{Binding Title}"
                                               FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Grid.Column="1" FontSize="12" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▲" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                                    <Setter Property="Text" Value="▼" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                    <WebView IsVisible="{Binding IsExpanded}" HeightRequest="320" Margin="0,4,0,8">
                                        <WebView.Source>
                                            <HtmlWebViewSource Html="{Binding Html}" />
                                        </WebView.Source>
                                    </WebView>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Nothing to show yet." FontSize="12" Opacity="0.6" Padding="16,10" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.1"
                             Color="{AppThemeBinding Light=Black, Dark=White}" />

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: Support (was Feedback)                  -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          IsVisible="{Binding CanAccessFeedback}"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="Feedback" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="Support"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsFeedbackExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsFeedbackExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsFeedbackExpanded}"
                                         Spacing="8" Padding="12,10"
                                         BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}">

                        <Label FontSize="11"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#777777}"
                               LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="All feedback goes straight to the " />
                                    <Span Text="J1S Sports" FontAttributes="Bold" />
                                    <Span Text=" Discord server, in the " />
                                    <Span Text="#ncaa-football" FontAttributes="Bold" />
                                    <Span Text=" channel. Join in to see the status of your suggestions and what's changing next." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="Found a bug? Have an idea? Let us know."
                               FontSize="12" Opacity="0.7" />

                        <Editor Text="{Binding FeedbackText}"
                                Placeholder="What's on your mind..."
                                HeightRequest="100"
                                AutoSize="TextChanges" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label FontSize="12">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="or you can " TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                            <Span Text="email the Dev Team"
                                                  FontAttributes="Bold"
                                                  TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                                <Span.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding EmailSupportCommand}" />
                                                </Span.GestureRecognizers>
                                            </Span>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding FeedbackStatus}"
                                       FontSize="11" Opacity="0.7" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 4"
                                    Stroke="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                    StrokeThickness="1"
                                    Padding="14,6"
                                    VerticalOptions="Center"
                                    IsEnabled="{Binding CanSubmitFeedback}">
                                <Label Text="Send"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SubmitFeedbackCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.1"
                             Color="{AppThemeBinding Light=Black, Dark=White}" />

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- SECTION: Debug Log                               -->
                    <!-- ═══════════════════════════════════════════════ -->

                    <Grid ColumnDefinitions="*,24"
                          Padding="12,5"
                          IsVisible="{Binding CanAccessDebugLog}"
                          BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSectionCommand}"
                                                  CommandParameter="DebugLog" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="Debug Log"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsDebugLogExpanded}" Value="True">
                                    <Setter Property="Text" Value="▲" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsDebugLogExpanded}" Value="False">
                                    <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsDebugLogExpanded}" Spacing="0">

                        <!-- Toolbar: entry count + clear -->
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8"
                              Padding="12,8"
                              BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}">
                            <Label Grid.Column="0"
                                   Text="{Binding LogEntryCount, StringFormat='{0} entries'}"
                                   FontSize="11" Opacity="0.6"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 4"
                                    Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                                    StrokeThickness="1"
                                    Padding="10,4">
                                <Label Text="Refresh"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RefreshLogCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 4"
                                    Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                                    StrokeThickness="1"
                                    Padding="10,4">
                                <Label Text="Clear"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearLogCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                        <!-- Log entries — newest first -->
                        <ScrollView HeightRequest="300"
                                    BackgroundColor="{AppThemeBinding Light=#1A1A1A, Dark=#0D0D0D}">
                            <CollectionView ItemsSource="{Binding LogEntries}"
                                            ItemSizingStrategy="MeasureAllItems">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:LogEntry">
                                        <Label Text="{Binding Display}"
                                               FontSize="9"
                                               TextColor="{Binding LevelColor}"
                                               Padding="8,2"
                                               LineBreakMode="WordWrap" />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="No log entries yet."
                                           FontSize="11" Opacity="0.5"
                                           HorizontalOptions="Center"
                                           Padding="0,20"
                                           TextColor="#888888" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </ScrollView>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 2: Status bar                                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" HeightRequest="24"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
            <Label Text="{Binding StatusMessage}"
                   Padding="8,0" FontSize="10" Opacity="0.5"
                   VerticalOptions="Center" HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Light=#444444, Dark=#AAAAAA}" />
        </Grid>

    </Grid>
</ContentPage>
