<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SaturdayPulse.Models"
             xmlns:viewmodels="clr-namespace:SaturdayPulse.ViewModels"
             xmlns:controls="clr-namespace:SaturdayPulse.Controls"
             xmlns:converters="clr-namespace:SaturdayPulse.Converters"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="SaturdayPulse.Views.MyTeamsPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False">

  <!--
    NOTE on x:Name="ThisPage": the inline templates below call back via
    {Binding Source={x:Reference ThisPage}, Path=BindingContext.<Command>}
    — this page's root MUST keep that name for those command bindings to
    resolve. (Reverted from shared merged-dictionary templates back to
    inline — see note in SchedulePage.xaml/PowerRankingsPage.xaml.)
  -->

  <ContentPage.Resources>
    <!-- Season Pass gating (2026-07-25) — masks projected Score/Spread/O-U
         numbers with a lock glyph for free users. Declared locally rather
         than in a global resource dictionary since App.xaml wasn't part of
         this pass. -->
    <converters:ProjectionGateConverter x:Key="ProjectionGateConverter" />
    <DataTemplate x:Key="GameRowTemplate" x:DataType="viewmodels:MyTeamsGameRow">
  <Grid>

    <!-- ── Bye Week row — Game is null, see MyTeamsGameRow.IsByeWeek ── -->
    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsByeWeek}">
      <Grid Padding="6,10,8,10" ColumnDefinitions="Auto,*">
        <Grid.Triggers>
          <DataTrigger TargetType="Grid" Binding="{Binding IsSelectedWeek}" Value="True">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0EBFF, Dark=#2A2040}" />
          </DataTrigger>
          <DataTrigger TargetType="Grid" Binding="{Binding IsSelectedWeek}" Value="False">
            <Setter Property="BackgroundColor" Value="Transparent" />
          </DataTrigger>
        </Grid.Triggers>
        <Label Grid.Column="0" Text="{Binding Week, StringFormat='Wk{0}'}"
               FontSize="11" TextColor="#80FFFFFF" VerticalOptions="Center" />
        <Label Grid.Column="1" Text="Bye Week" FontSize="12" FontAttributes="Italic"
               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
      </Grid>
      <BoxView HeightRequest="1" 
               Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />
    </VerticalStackLayout>

  <VerticalStackLayout Spacing="0" IsVisible="{Binding IsByeWeek, Converter={StaticResource InvertedBoolConverter}}">

    <!-- ── Compact single-line row ── -->
    <Grid ColumnDefinitions="Auto,*,100,100"
          Padding="6,0,8,0" ColumnSpacing="6">

      <Grid.Triggers>
        <DataTrigger TargetType="Grid" Binding="{Binding IsSelectedWeek}" Value="True">
          <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0EBFF, Dark=#2A2040}" />
        </DataTrigger>
        <DataTrigger TargetType="Grid" Binding="{Binding IsSelectedWeek}" Value="False">
          <Setter Property="BackgroundColor" Value="Transparent" />
        </DataTrigger>
      </Grid.Triggers>

      <!-- Tap anywhere on the row (that isn't the star/heart/Details link,
           which each capture their own tap) to jump the week selector to
           this game's week. -->
      <Grid.GestureRecognizers>
        <TapGestureRecognizer
            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectWeekCommand}"
            CommandParameter="{Binding Week}" />
      </Grid.GestureRecognizers>

      <!-- Star + date, tight group -->
      <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="2">
        <controls:FollowGameIcon Grid.Column="0"
              IsFollowed="{Binding Game.IsGameFavorited}"
              VerticalOptions="Center" HorizontalOptions="Start">
          <controls:FollowGameIcon.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePersonalGameCommand}"
                  CommandParameter="{Binding Game}" />
          </controls:FollowGameIcon.GestureRecognizers>
        </controls:FollowGameIcon>
        <Label Grid.Column="1" Text="{Binding DateShort}"
               FontSize="11" TextColor="#99FFFFFF"
               VerticalOptions="Center" />
      </Grid>

      <!-- @/vs + heart + opponent -->
      <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="3">
        <Label Grid.Column="0" Text="{Binding AtPrefix}"
               FontSize="13" TextColor="#8CFFFFFF"
               VerticalOptions="Center" />
        <controls:FollowTeamIcon Grid.Column="1"
              IsFollowed="{Binding OpponentIsFollowed}"
              VerticalOptions="Center" HorizontalOptions="Start">
          <controls:FollowTeamIcon.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                  CommandParameter="{Binding OpponentTeamId}" />
          </controls:FollowTeamIcon.GestureRecognizers>
        </controls:FollowTeamIcon>
        <Label Grid.Column="2" Text="{Binding OpponentName}"
               FontSize="12" VerticalOptions="Center"
               LineBreakMode="TailTruncation"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToGameCommand}"
                  CommandParameter="{Binding Game}" />
          </Label.GestureRecognizers>
        </Label>
      </Grid>

      <!-- Result letter + Score — fixed-width column so it lines up across rows -->
      <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="2">
        <Label Grid.Column="0" Text="{Binding ResultLetter}"
               FontSize="10" FontAttributes="Bold"
               VerticalOptions="Center">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding ResultLetter}" Value="(W)">
              <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ResultWinLight}, Dark={StaticResource ResultWinDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ResultLetter}" Value="(L)">
              <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ResultLossLight}, Dark={StaticResource ResultLossDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding ResultLetter}" Value="(T)">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
        <Label Grid.Column="1" FontSize="10" FontAttributes="Bold"
               VerticalOptions="Center" HorizontalTextAlignment="End"
               LineBreakMode="NoWrap"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
          <Label.Text>
            <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
              <Binding Path="ScoreLine" />
              <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
              <Binding Path="Game.Year" />
            </MultiBinding>
          </Label.Text>
        </Label>
      </Grid>

      <!-- Spread / O-U, stacked — fixed-width column, same reason -->
      <VerticalStackLayout Grid.Column="3" Spacing="0"
                           VerticalOptions="Center">
        <Label FontSize="10" TextColor="#A6FFFFFF" HorizontalTextAlignment="End">
          <Label.Text>
            <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
              <Binding Path="SpreadLine" />
              <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
              <Binding Path="Game.Year" />
            </MultiBinding>
          </Label.Text>
        </Label>
        <Label FontSize="10" TextColor="#A6FFFFFF" HorizontalTextAlignment="End">
          <Label.Text>
            <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
              <Binding Path="OULine" />
              <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
              <Binding Path="Game.Year" />
            </MultiBinding>
          </Label.Text>
        </Label>
      </VerticalStackLayout>

    </Grid>


    <BoxView HeightRequest="1" 
             Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

  </VerticalStackLayout>

  </Grid>
    </DataTemplate>
  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,*,24">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 0: Team chip scroller — same visual/interaction  -->
    <!-- pattern as MainPage's Week strip. Tap-only; no swipe -->
    <!-- attached here (page swipe stays on tab switching).   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <ScrollView Grid.Row="0"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#252525}">
      <HorizontalStackLayout Spacing="0" Padding="6,0"
                             BindableLayout.ItemsSource="{Binding Chips}">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="viewmodels:TeamChipItem">
            <Grid Padding="2,0" MinimumWidthRequest="64">
              <VerticalStackLayout Spacing="0">
                <Label Text="{Binding TeamName}"
                       FontSize="13"
                       HorizontalOptions="Center" Padding="10,8"
                       LineBreakMode="TailTruncation">
                  <Label.Triggers>
                    <!-- Primary chip: bold + accent color, always -->
                    <DataTrigger TargetType="Label" Binding="{Binding IsPrimary}" Value="True">
                      <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                      <Setter Property="TextColor" Value="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                    </DataTrigger>
                  </Label.Triggers>
                </Label>
                <BoxView HeightRequest="2" HorizontalOptions="Fill"
                         Color="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                         IsVisible="{Binding IsSelected}" />
              </VerticalStackLayout>

              <!-- Small primary indicator (★) above the label -->
              <Label Text="★" FontSize="8"
                     TextColor="{AppThemeBinding Light=#BF5700, Dark=#FFB870}"
                     HorizontalOptions="Center" VerticalOptions="Start"
                     Margin="0,0,0,0"
                     IsVisible="{Binding IsPrimary}" />

              <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectTeamCommand}"
                    CommandParameter="{Binding TeamId}" />
              </Grid.GestureRecognizers>
            </Grid>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </HorizontalStackLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 1: Pinned rankings card + scrollable schedule    -->
    <!-- Team card is now a plain static view (not templated) -->
    <!-- bound directly to SelectedTeamRanking, sitting in its -->
    <!-- own Auto row above the CollectionView — it no longer  -->
    <!-- scrolls with the game list.                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">

      <!-- Pinned team card -->
      <Grid Grid.Row="0" x:Name="PinnedTeamCardGrid" IsVisible="{Binding HasSelectedTeamRanking}">

    <VerticalStackLayout Spacing="0">

      <!-- ── Column headers — static, no sort (unlike Rankings page) ── -->
      <Grid Padding="4,3"
            ColumnDefinitions="44,22,*,76,54,50,46"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
        <Label Grid.Column="0" Text="Rank"   FontAttributes="Bold" FontSize="10" />
        <Label Grid.Column="1" Text="" />
        <Label Grid.Column="2" Text="Team"   FontAttributes="Bold" FontSize="10" />
        <Label Grid.Column="3" Text="Record" FontAttributes="Bold" FontSize="10" />
        <Label Grid.Column="4" Text="Rating" FontAttributes="Bold" FontSize="10" />
        <Label Grid.Column="5" Text="SOS"    FontAttributes="Bold" FontSize="10" />
        <VerticalStackLayout Grid.Column="6" Spacing="0" HorizontalOptions="Center">
          <Label Text="Roster" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" />
          <Label Text="Rank" FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
      </Grid>

    <VerticalStackLayout Spacing="0" BindingContext="{Binding SelectedTeamRanking}">

      <!-- ── Main row ── -->
      <Grid Padding="4,3"
            ColumnDefinitions="44,22,*,76,54,50,46"
            BackgroundColor="{Binding IsOddRow, Converter={StaticResource OddRowBackgroundConverter}}">

        <!-- Rank badge -->
        <Grid Grid.Column="0"
              Padding="2,2"
              HeightRequest="26"
              WidthRequest="40"
              HorizontalOptions="Center"
              VerticalOptions="Center">
          <BoxView CornerRadius="3"
                   Color="{Binding IsTop25, Converter={StaticResource BoolToColorConverter}}" />
          <Label Text="{Binding OverallRank}"
                 FontSize="11" FontAttributes="Bold" TextColor="White"
                 HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Heart: follow team -->
        <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               Text="{Binding IsFollowed, Converter={StaticResource FollowTeamGlyphConverter}}"
               TextColor="{Binding IsFollowed, Converter={StaticResource FollowTeamColorConverter}}"
               FontSize="{StaticResource TeamIconSize}">
          </Label>
</Border>

        <!-- Team + Conf · Tier -->
        <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
          <Label Text="{Binding TeamName}"
                 FontSize="13" LineBreakMode="TailTruncation"/>
          <Label Text="{Binding DisplayConferenceTier}"
                 FontSize="10" TextColor="#99FFFFFF" LineBreakMode="TailTruncation"/>
        </VerticalStackLayout>

        <Label Grid.Column="3" Text="{Binding RecordWithProjection}"
               FontSize="11" VerticalOptions="Center"/>
        <Label Grid.Column="4" Text="{Binding DisplayRank}"
               FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
        <Label Grid.Column="5" Text="{Binding DisplaySOS}"
               FontSize="11" VerticalOptions="Center"/>
        <Label Grid.Column="6" Text="{Binding DisplayRosterRank}"
               FontSize="11" VerticalOptions="Center" HorizontalOptions="Center"/>

      </Grid>

      <!-- ── Toggle bar: Trend/Pedigree | Season Arc | Offense/Defense | Roster ── -->
      <Grid ColumnDefinitions="1.6*,1*,1.6*,0.8*"
            Padding="4,2,8,2"
            BackgroundColor="{Binding IsOddRow, Converter={StaticResource OddRowBackgroundConverter}}">

        <!-- LEFT: Trend / Pedigree — disabled/grayed without Season Pass,
             not tappable, no popup (design locked 2026-07-24). -->
        <Border Grid.Column="0" HorizontalOptions="Start" IsVisible="{Binding HasTrendData}" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleTrendExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Trend / Pedigree" />
              <Span Text="  " />
              <Span Text="{Binding TrendExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

        <!-- Season Arc — disabled/grayed without Season Pass -->
        <Border Grid.Column="1" HorizontalOptions="Center" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleArcExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Season Arc" />
              <Span Text="  " />
              <Span Text="{Binding ArcExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

        <!-- Offense / Defense — disabled/grayed without Season Pass. Moved from
             HorizontalOptions="End" to "Center": no longer the rightmost column
             now that Roster sits to its right. -->
        <Border Grid.Column="2" HorizontalOptions="Center" IsVisible="{Binding HasOffenseDefenseData}" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleStatsExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Offense / Defense" />
              <Span Text="  " />
              <Span Text="{Binding StatsExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

        <!-- RIGHT: Roster — gated behind Season Pass like Trend/Pedigree and
             Season Arc. No IsVisible data-presence gate (matches
             PowerRankingsPage.xaml's Roster link — availability isn't known
             until the lazy fetch runs). -->
        <Border Grid.Column="3" HorizontalOptions="End" IsEnabled="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleRosterExpandCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label
               FontSize="11"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Roster" />
              <Span Text="  " />
              <Span Text="{Binding RosterExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                         Value="False">
              <Setter Property="TextColor" Value="{AppThemeBinding Light=#596B4EAE, Dark=#599B7EDE}" />
            </DataTrigger>
          </Label.Triggers>
          </Label>
</Border>

      </Grid>

      <!-- ── Trend / Pedigree expanded panel (lazy) ── -->
      <controls:LazyContentView IsExpanded="{Binding IsTrendExpanded}">
        <controls:LazyContentView.LazyTemplate>
          <DataTemplate>
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#3A3A3A}"
                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#202020}"
                    Margin="4,0,4,6">
              <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,8,12,2">
                  <Label Grid.Column="0"
                         Text="Trend / Pedigree History"
                         FontSize="10" FontAttributes="Bold"
                         TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                  <Label Grid.Column="1"
                         Text="{Binding Record}"
                         FontSize="9" TextColor="#99FFFFFF"
                         Margin="0,0,10,0" />
                  <VerticalStackLayout Grid.Column="2" Spacing="0">
                    <Label Text="{Binding TrendRating, StringFormat='Trend {0:F4}'}"
                           FontSize="9" FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
                    <Label Text="{Binding PedigreeRating, StringFormat='Pedigree {0:F4}'}"
                           FontSize="9" FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light=#3D7AB5, Dark=#5FA8E8}" />
                  </VerticalStackLayout>
                </Grid>

                <chart:SfCartesianChart HeightRequest="160" Margin="8,0,8,8">
                  <chart:SfCartesianChart.XAxes>
                    <chart:CategoryAxis ShowMajorGridLines="False"
                                        LabelPlacement="BetweenTicks" />
                  </chart:SfCartesianChart.XAxes>
                  <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis Minimum="0" Maximum="1.2"
                                         Interval="0.2"
                                         ShowMajorGridLines="True" />
                  </chart:SfCartesianChart.YAxes>
                  <chart:SplineSeries
                      ItemsSource="{Binding TrendPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Trend"
                      Fill="{AppThemeBinding Light={StaticResource AccentChartLight}, Dark={StaticResource AccentChartDark}}"
                      StrokeWidth="3.5" EnableTooltip="True" />
                  <chart:SplineSeries
                      ItemsSource="{Binding PedigreePoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Pedigree"
                      Fill="{AppThemeBinding Light=#C89B3C, Dark=#FFD166}"
                      StrokeWidth="2.5" EnableTooltip="True" />
                  <chart:SfCartesianChart.Legend>
                    <chart:ChartLegend Placement="Bottom" />
                  </chart:SfCartesianChart.Legend>
                </chart:SfCartesianChart>

              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </controls:LazyContentView.LazyTemplate>
      </controls:LazyContentView>

      <!-- ── Season Arc expanded panel (lazy) ── -->
      <controls:LazyContentView IsExpanded="{Binding IsArcExpanded}">
        <controls:LazyContentView.LazyTemplate>
          <DataTemplate>
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#C8E6C9, Dark=#2E4A35}"
                    BackgroundColor="{AppThemeBinding Light=#F1F8F2, Dark=#1A2A1E}"
                    Margin="4,0,4,6">
              <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="*,Auto" Padding="12,8,12,2">
                  <Label Grid.Column="0"
                         Text="Season Arc"
                         FontSize="10" FontAttributes="Bold"
                         TextColor="{AppThemeBinding Light=#2E8B57, Dark=#4CAF84}" />
                  <Label Grid.Column="1"
                         Text="{Binding Record}"
                         FontSize="9" TextColor="#99FFFFFF" />
                </Grid>

                <chart:SfCartesianChart HeightRequest="170" Margin="8,0,8,8">
                  <chart:SfCartesianChart.XAxes>
                    <chart:NumericalAxis ShowMajorGridLines="False"
                                         Minimum="1" Interval="2">
                      <chart:NumericalAxis.Title>
                        <chart:ChartAxisTitle Text="Week" FontSize="9" />
                      </chart:NumericalAxis.Title>
                    </chart:NumericalAxis>
                  </chart:SfCartesianChart.XAxes>
                  <chart:SfCartesianChart.YAxes>
                    <!-- Single shared axis — Rating/SOS/WinPct all fall in -1 to 2 range -->
                    <chart:NumericalAxis
                       Minimum="-1" Maximum="2" Interval="0.5"
                       ShowMajorGridLines="True" />
                  </chart:SfCartesianChart.YAxes>
                  <chart:SplineSeries
                      ItemsSource="{Binding ArcRankingPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Rating"
                      Fill="{AppThemeBinding Light={StaticResource AccentChartLight}, Dark={StaticResource AccentChartDark}}"
                      StrokeWidth="3" EnableTooltip="True" />
                  <chart:SplineSeries
                      ItemsSource="{Binding ArcSosPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="SOS"
                      Fill="{AppThemeBinding Light=#FF4444, Dark=#FF6B6B}"
                      StrokeWidth="2.5" EnableTooltip="True" />
                  <chart:SplineSeries
                      ItemsSource="{Binding ArcWinPctPoints}"
                      XBindingPath="Index" YBindingPath="Value"
                      Label="Win %"
                      Fill="{AppThemeBinding Light=#FFE500, Dark=#FFE500}"
                      StrokeWidth="2" EnableTooltip="True" />
                  <chart:SfCartesianChart.Legend>
                    <chart:ChartLegend Placement="Bottom" />
                  </chart:SfCartesianChart.Legend>
                </chart:SfCartesianChart>

              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </controls:LazyContentView.LazyTemplate>
      </controls:LazyContentView>

      <!-- ── Offense / Defense expanded panel ── -->
      <!-- Labels only — no charts — IsVisible is fine here -->
      <VerticalStackLayout IsVisible="{Binding IsStatsExpanded}"
                           Spacing="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

        <Grid ColumnDefinitions="*,*,*" Padding="8,6,8,4" ColumnSpacing="4">
          <VerticalStackLayout Grid.Column="0" Spacing="1">
            <Label Text="Offensive Rank" FontSize="9" TextColor="#99FFFFFF" />
            <Label Text="{Binding OffensiveRankDisplay}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="1">
            <Label Text="Avg. Points Scored" FontSize="9" TextColor="#99FFFFFF" />
            <Label Text="{Binding AvgPointsScored, StringFormat='{0:F1}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="2" Spacing="1">
            <Label Text="Offensive Index (Std-Z)" FontSize="9" TextColor="#99FFFFFF" />
            <Label Text="{Binding OffensiveZScore, StringFormat='{0:F4}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
        </Grid>

        <BoxView HeightRequest="1"  Margin="8,0"
                 Color="{AppThemeBinding Light=#14000000, Dark=#14FFFFFF}" />

        <Grid ColumnDefinitions="*,*,*" Padding="8,4,8,6" ColumnSpacing="4">
          <VerticalStackLayout Grid.Column="0" Spacing="1">
            <Label Text="Defensive Rank" FontSize="9" TextColor="#99FFFFFF" />
            <Label Text="{Binding DefensiveRankDisplay}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="1">
            <Label Text="Avg. Points Allowed" FontSize="9" TextColor="#99FFFFFF" />
            <Label Text="{Binding AvgPointsAllowed, StringFormat='{0:F1}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="2" Spacing="1">
            <Label Text="Defensive Index (Std-Z)" FontSize="9" TextColor="#99FFFFFF" />
            <Label Text="{Binding DefensiveZScore, StringFormat='{0:F4}'}"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          </VerticalStackLayout>
        </Grid>

      </VerticalStackLayout>
      <!-- ── Roster Changes expanded panel — summary table + one shared
           expandable list area (Recruiting / Portal In / Portal Out).
           Retained/Departed/New are still in the API response but not
           rendered here — reserved for the future standalone Roster page
           per 2026-08 UX decision. ── -->
      <VerticalStackLayout IsVisible="{Binding IsRosterExpanded}"
                           Spacing="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

        <Label Text="No roster data available for this year."
               IsVisible="{Binding ShowRosterEmptyState}"
               FontSize="10" TextColor="#99FFFFFF" Padding="8,6" />

        <VerticalStackLayout IsVisible="{Binding HasRosterData}" Spacing="0">

          <!-- ── Summary table: Prior | Current | Change, one row per metric.
               Positive/negative Change values use a 3-section custom numeric
               format string ("+0.0;-0.0;0.0") — standard .NET formatting,
               not a converter — to get an explicit "+" on gains. ── -->
          <Grid ColumnDefinitions="*,50,50,55" Padding="8,6,8,2" RowSpacing="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Label Grid.Row="0" Grid.Column="1" Text="Prior" FontSize="8" TextColor="#80FFFFFF" HorizontalOptions="End" />
            <Label Grid.Row="0" Grid.Column="2" Text="Now" FontSize="8" TextColor="#80FFFFFF" HorizontalOptions="End" />
            <Label Grid.Row="0" Grid.Column="3" Text="Change" FontSize="8" TextColor="#80FFFFFF" HorizontalOptions="End" />

            <!-- Roster Rank -->
            <Label Grid.Row="1" Grid.Column="0" Text="Roster Rank" FontSize="10" VerticalOptions="Center" />
            <Label Grid.Row="1" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="#B3FFFFFF"
                   Text="{Binding RosterChanges.RosterStrength.PriorRank, StringFormat='#{0}'}" />
            <Label Grid.Row="1" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.RosterStrength.CurrentRank, StringFormat='#{0}'}" />
            <Label Grid.Row="1" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.RosterStrength.RankChange, StringFormat='{0:+0;-0;0}'}" />

            <!-- Roster Rating (10 × Φ(ZRoster)) -->
            <Label Grid.Row="2" Grid.Column="0" Text="Roster Rating" FontSize="10" VerticalOptions="Center" />
            <Label Grid.Row="2" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="#B3FFFFFF"
                   Text="{Binding RosterChanges.RosterStrength.PriorRatingDisplay, StringFormat='{0:F1}'}" />
            <Label Grid.Row="2" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.RosterStrength.CurrentRatingDisplay, StringFormat='{0:F1}'}" />
            <Label Grid.Row="2" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.RosterStrength.RatingChange, StringFormat='{0:+0.0;-0.0;0.0}'}" />

            <!-- Recruiting — tappable, opens the shared list below -->
            <Border Grid.Column="0" Grid.Row="3" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleRecruitingListCommand}"
                    CommandParameter="{Binding .}" />
              </Border.GestureRecognizers>
  <Label FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="Recruiting  " />
                  <Span Text="{Binding RecruitingListIcon}" FontSize="8" />
                </FormattedString>
              </Label.FormattedText>
              </Label>
</Border>
            <Label Grid.Row="3" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="#B3FFFFFF"
                   Text="{Binding RosterChanges.RecruitingComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Row="3" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.RecruitingComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Row="3" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.RecruitingComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />

            <!-- Portal In — tappable -->
            <Border Grid.Column="0" Grid.Row="4" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePortalInListCommand}"
                    CommandParameter="{Binding .}" />
              </Border.GestureRecognizers>
  <Label FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource ResultWinLight}, Dark={StaticResource ResultWinDark}}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="Portal In  " />
                  <Span Text="{Binding PortalInListIcon}" FontSize="8" />
                </FormattedString>
              </Label.FormattedText>
              </Label>
</Border>
            <Label Grid.Row="4" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="#B3FFFFFF"
                   Text="{Binding RosterChanges.PortalInComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Row="4" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource ResultWinLight}, Dark={StaticResource ResultWinDark}}"
                   Text="{Binding RosterChanges.PortalInComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Row="4" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.PortalInComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />

            <!-- Portal Out — tappable. Values are pre-negated at the API. -->
            <Border Grid.Column="0" Grid.Row="5" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePortalOutListCommand}"
                    CommandParameter="{Binding .}" />
              </Border.GestureRecognizers>
  <Label FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource ResultLossLight}, Dark={StaticResource ResultLossDark}}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="Portal Out  " />
                  <Span Text="{Binding PortalOutListIcon}" FontSize="8" />
                </FormattedString>
              </Label.FormattedText>
              </Label>
</Border>
            <Label Grid.Row="5" Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="#B3FFFFFF"
                   Text="{Binding RosterChanges.PortalOutComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Row="5" Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource ResultLossLight}, Dark={StaticResource ResultLossDark}}"
                   Text="{Binding RosterChanges.PortalOutComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Row="5" Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.PortalOutComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />

          </Grid>

          <!-- Portal Composite — not tappable (derived, no list of its own).
               Separate row below the main grid so its own emphasis doesn't
               compete with the tappable rows above. -->
          <Grid ColumnDefinitions="*,50,50,55" Padding="8,2,8,6">
            <Label Grid.Column="0" Text="Portal Net" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
            <Label Grid.Column="1" FontSize="10" HorizontalOptions="End" TextColor="#B3FFFFFF"
                   Text="{Binding RosterChanges.PortalNetComposite.Prior, StringFormat='{0:F1}'}" />
            <Label Grid.Column="2" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                   Text="{Binding RosterChanges.PortalNetComposite.Current, StringFormat='{0:F1}'}" />
            <Label Grid.Column="3" FontSize="10" FontAttributes="Bold" HorizontalOptions="End"
                   Text="{Binding RosterChanges.PortalNetComposite.Change, StringFormat='{0:+0.0;-0.0;0.0}'}" />
          </Grid>

          <BoxView HeightRequest="1"  Margin="8,0"
                   Color="{AppThemeBinding Light=#14000000, Dark=#14FFFFFF}" />

          <!-- ── Shared list area — one of the three below is ever visible at
               once, driven by ActiveRosterListKey. Physically all three sit
               in the same position; only the active one has height. ── -->

          <VerticalStackLayout IsVisible="{Binding IsRecruitingListActive}"
                               Padding="8,4,8,6" Spacing="2">

            <!-- Header — no label over the star-rank column -->
            <Grid ColumnDefinitions="20,2*,*,50" Padding="0,0,0,2">
              <Label Grid.Column="1" Text="Player" FontSize="8" FontAttributes="Bold" TextColor="#80FFFFFF" />
              <Label Grid.Column="2" Text="Comment" FontSize="8" FontAttributes="Bold" TextColor="#80FFFFFF" />
              <Label Grid.Column="3" Text="Rating" FontSize="8" FontAttributes="Bold"
                     HorizontalOptions="End" TextColor="#80FFFFFF" />
            </Grid>
            <BoxView HeightRequest="1" Margin="0,0,0,2"
                     Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            <VerticalStackLayout Spacing="2"
                                 BindableLayout.ItemsSource="{Binding RosterChanges.RecruitingClass}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:RecruitSummary">
                  <Grid ColumnDefinitions="20,2*,*,50" Padding="0,1">
                    <Label Grid.Column="0" Text="{Binding Stars, StringFormat='{0}★'}" FontSize="9" />
                    <Label Grid.Column="1" FontSize="9">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="{Binding Name}" />
                          <Span Text=" · " TextColor="#80FFFFFF" />
                          <Span Text="{Binding Position}" TextColor="#B3FFFFFF" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="2" Text="" FontSize="9" />
                    <Label Grid.Column="3" Text="{Binding Rating, StringFormat='{0:F3}'}"
                           FontSize="9" HorizontalOptions="End" TextColor="#B3FFFFFF" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </VerticalStackLayout>

          <VerticalStackLayout IsVisible="{Binding IsPortalInListActive}"
                               Padding="8,4,8,6" Spacing="2">

            <Grid ColumnDefinitions="2*,*,50" Padding="0,0,0,2">
              <Label Grid.Column="0" Text="Player" FontSize="8" FontAttributes="Bold" TextColor="#80FFFFFF" />
              <Label Grid.Column="1" Text="Comment" FontSize="8" FontAttributes="Bold" TextColor="#80FFFFFF" />
              <Label Grid.Column="2" Text="Rating" FontSize="8" FontAttributes="Bold"
                     HorizontalOptions="End" TextColor="#80FFFFFF" />
            </Grid>
            <BoxView HeightRequest="1" Margin="0,0,0,2"
                     Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            <VerticalStackLayout Spacing="2"
                                 BindableLayout.ItemsSource="{Binding RosterChanges.PortalIn}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:PortalTransfer">
                  <Grid ColumnDefinitions="2*,*,50" Padding="0,1">
                    <Label Grid.Column="0" FontSize="9">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="{Binding Name}" />
                          <Span Text=" · " TextColor="#80FFFFFF" />
                          <Span Text="{Binding Position}" TextColor="#B3FFFFFF" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding OtherTeam, StringFormat='from {0}'}"
                           FontSize="9" TextColor="#99FFFFFF" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding Rating, StringFormat='{0:F3}'}"
                           FontSize="9" HorizontalOptions="End" TextColor="#B3FFFFFF" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </VerticalStackLayout>

          <VerticalStackLayout IsVisible="{Binding IsPortalOutListActive}"
                               Padding="8,4,8,6" Spacing="2">

            <Grid ColumnDefinitions="2*,*,50" Padding="0,0,0,2">
              <Label Grid.Column="0" Text="Player" FontSize="8" FontAttributes="Bold" TextColor="#80FFFFFF" />
              <Label Grid.Column="1" Text="Comment" FontSize="8" FontAttributes="Bold" TextColor="#80FFFFFF" />
              <Label Grid.Column="2" Text="Rating" FontSize="8" FontAttributes="Bold"
                     HorizontalOptions="End" TextColor="#80FFFFFF" />
            </Grid>
            <BoxView HeightRequest="1" Margin="0,0,0,2"
                     Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

            <VerticalStackLayout Spacing="2"
                                 BindableLayout.ItemsSource="{Binding RosterChanges.PortalOut}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:PortalTransfer">
                  <Grid ColumnDefinitions="2*,*,50" Padding="0,1">
                    <Label Grid.Column="0" FontSize="9">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="{Binding Name}" />
                          <Span Text=" · " TextColor="#80FFFFFF" />
                          <Span Text="{Binding Position}" TextColor="#B3FFFFFF" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding OtherTeam, StringFormat='to {0}'}"
                           FontSize="9" TextColor="#99FFFFFF" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding Rating, StringFormat='{0:F3}'}"
                           FontSize="9" HorizontalOptions="End" TextColor="#B3FFFFFF" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

          </VerticalStackLayout>

        </VerticalStackLayout>
      </VerticalStackLayout>


      <BoxView HeightRequest="1" 
               Color="{AppThemeBinding Light=#1A000000, Dark=#1AFFFFFF}" />

    </VerticalStackLayout>
    </VerticalStackLayout>
        </Grid>

      <RefreshView Grid.Row="1"
                   Command="{Binding RefreshCommand}"
                   IsRefreshing="{Binding IsBusy}">

        <CollectionView ItemsSource="{Binding SelectedTeamGames}"
                        ItemTemplate="{StaticResource GameRowTemplate}"
                        ItemSizingStrategy="MeasureAllItems">


          <CollectionView.EmptyView>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
              <Label Text="{Binding EmptyMessage}" FontSize="14" TextColor="#B3FFFFFF"
                     HorizontalOptions="Center" Margin="0,10,0,0"/>
            </VerticalStackLayout>
          </CollectionView.EmptyView>

        </CollectionView>

      </RefreshView>

      <!-- ═══════════════════════════════════════════ -->
      <!-- Postseason — collapsible, only shown once    -->
      <!-- postseason games are actually loaded         -->
      <!-- ═══════════════════════════════════════════ -->
      <VerticalStackLayout Grid.Row="2" IsVisible="{Binding HasPostseasonGames}">

        <Grid ColumnDefinitions="*,24"
              Padding="12,5"
              BackgroundColor="{AppThemeBinding Light=#F0EBF8, Dark=#2A2040}">
          <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TogglePostseasonCommand}" />
          </Grid.GestureRecognizers>
          <Label Grid.Column="0"
                 Text="Postseason"
                 FontSize="15" FontAttributes="Bold"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                 VerticalOptions="Center" />
          <Label Grid.Column="1"
                 Text="{Binding PostseasonExpandIcon}"
                 FontSize="14" FontAttributes="Bold"
                 HorizontalOptions="Center" VerticalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
        </Grid>

        <CollectionView ItemsSource="{Binding SelectedTeamPostseasonGames}"
                        ItemTemplate="{StaticResource GameRowTemplate}"
                        ItemSizingStrategy="MeasureAllItems"
                        IsVisible="{Binding IsPostseasonExpanded}" />

      </VerticalStackLayout>

    </Grid>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 2: Status bar                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" HeightRequest="24" ColumnDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
      <Label Grid.Column="0" Text="( ) = projected value : All times Eastern Time"
             Padding="8,0" FontSize="11" FontAttributes="Italic"
             VerticalOptions="Center" HorizontalOptions="Start"
             TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" />
      <Label Grid.Column="1" Text="{Binding StatusMessage}"
             Padding="8,0" FontSize="10"
             VerticalOptions="Center" HorizontalOptions="End"
             TextColor="{AppThemeBinding Light=#444444, Dark=#AAAAAA}" />
    </Grid>

  </Grid>
</ContentPage>
